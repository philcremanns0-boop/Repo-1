{
  "name": "Angebots-Nachfass (Entwurf) - UNGETESTET",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            { "field": "days", "daysInterval": 1, "triggerAtHour": 8 }
          ]
        }
      },
      "id": "a1000000-0000-4000-8000-000000000001",
      "name": "Taeglich 08:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": { "__rl": true, "value": "PLATZHALTER_SHEET_ID", "mode": "id" },
        "sheetName": { "__rl": true, "value": "Angebote", "mode": "name" },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000002",
      "name": "Offene Angebote lesen",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [240, 0],
      "credentials": {
        "googleSheetsOAuth2Api": { "id": "PLATZHALTER", "name": "Google Sheets (anlegen)" }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.status }}",
              "rightValue": "offen",
              "operator": { "type": "string", "operation": "equals" }
            },
            {
              "id": "c2",
              "leftValue": "={{ $json.antwort_erhalten }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "empty", "singleValue": true }
            },
            {
              "id": "c3",
              "leftValue": "={{ $json.angebot_datum }}",
              "rightValue": "={{ $now.minus({ days: 3 }).toISO() }}",
              "operator": { "type": "dateTime", "operation": "before" }
            },
            {
              "id": "c4",
              "leftValue": "={{ $json.einwilligung_nachfass }}",
              "rightValue": "ja",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000003",
      "name": "Aelter als 3 Tage, ohne Antwort, Einwilligung",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [480, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "anthropic-version", "value": "2023-06-01" },
            { "name": "content-type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'claude-sonnet-5-5', max_tokens: 400, system: 'Du schreibst kurze, hoefliche Nachfass-Mails auf Deutsch fuer einen Handwerksbetrieb. Maximal 90 Woerter, Sie-Form, kein Druck, keine erfundenen Fakten, keine Rabatte, keine Fristen. Antworte nur mit dem Mailtext ohne Betreffzeile.', messages: [{ role: 'user', content: 'Kunde: ' + $json.kunde_name + '\\nGewerk/Projekt: ' + $json.projekt + '\\nAngebotsdatum: ' + $json.angebot_datum + '\\nAngebotssumme: ' + $json.summe + '\\nAbsender: ' + $json.absender_name }] }) }}",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000004",
      "name": "Claude: Nachfass-Text",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 0],
      "credentials": {
        "httpHeaderAuth": { "id": "PLATZHALTER", "name": "Anthropic API Key (Header x-api-key)" }
      }
    },
    {
      "parameters": {
        "resource": "draft",
        "operation": "create",
        "subject": "={{ 'Rueckfrage zu Ihrem Angebot vom ' + $('Offene Angebote lesen').item.json.angebot_datum }}",
        "message": "={{ $json.content[0].text }}",
        "options": {
          "sendTo": "={{ $('Offene Angebote lesen').item.json.kunde_email }}"
        }
      },
      "id": "a1000000-0000-4000-8000-000000000005",
      "name": "Gmail-Entwurf erstellen",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [960, 0],
      "credentials": {
        "gmailOAuth2": { "id": "PLATZHALTER", "name": "Gmail (anlegen)" }
      }
    },
    {
      "parameters": {
        "operation": "update",
        "documentId": { "__rl": true, "value": "PLATZHALTER_SHEET_ID", "mode": "id" },
        "sheetName": { "__rl": true, "value": "Angebote", "mode": "name" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "angebot_id": "={{ $('Offene Angebote lesen').item.json.angebot_id }}",
            "status": "nachfass_entwurf",
            "nachfass_entwurf_am": "={{ $now.toISODate() }}"
          },
          "matchingColumns": ["angebot_id"],
          "schema": []
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000006",
      "name": "Status zurueckschreiben",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [1200, 0],
      "credentials": {
        "googleSheetsOAuth2Api": { "id": "PLATZHALTER", "name": "Google Sheets (anlegen)" }
      }
    },
    {
      "parameters": {
        "content": "UNGETESTET. Vor Nutzung importieren und pruefen: Sheet-ID, Spaltennamen (status, antwort_erhalten, angebot_datum, einwilligung_nachfass, kunde_email, angebot_id), Credentials, Modellname. Es wird nur ein Entwurf erzeugt, nichts gesendet.",
        "height": 140,
        "width": 420
      },
      "id": "a1000000-0000-4000-8000-000000000007",
      "name": "Hinweis",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [0, -200]
    }
  ],
  "connections": {
    "Taeglich 08:00": { "main": [[{ "node": "Offene Angebote lesen", "type": "main", "index": 0 }]] },
    "Offene Angebote lesen": { "main": [[{ "node": "Aelter als 3 Tage, ohne Antwort, Einwilligung", "type": "main", "index": 0 }]] },
    "Aelter als 3 Tage, ohne Antwort, Einwilligung": { "main": [[{ "node": "Claude: Nachfass-Text", "type": "main", "index": 0 }], []] },
    "Claude: Nachfass-Text": { "main": [[{ "node": "Gmail-Entwurf erstellen", "type": "main", "index": 0 }]] },
    "Gmail-Entwurf erstellen": { "main": [[{ "node": "Status zurueckschreiben", "type": "main", "index": 0 }]] }
  },
  "pinData": {},
  "settings": { "executionOrder": "v1" },
  "active": false,
  "tags": []
}
